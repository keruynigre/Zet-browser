<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Üst çubuk: yuvarlak adres alanı, kalkan içinde -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:id="@+id/urlField"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/url_field_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/btnTor"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tor"
                    android:gravity="center"
                    android:paddingEnd="6dp"
                    android:text="🧅"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/siteIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingEnd="6dp"
                    android:text="🔒"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/url_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnDownload"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/download_video"
                    android:gravity="center"
                    android:text="⬇"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnShield"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/shield_bg"
                    android:contentDescription="@string/shield"
                    android:gravity="center"
                    android:minWidth="44dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/downloadBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/downloadText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/downloadProgress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progressTint="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/downloadCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cancel"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Alt çubuk: ana sayfa, yer işaretleri, ara, sekmeler, menü -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnHome"
                style="@style/BottomIcon"
                android:contentDescription="@string/home"
                android:src="@drawable/ic_home" />

            <ImageView
                android:id="@+id/btnBookmarks"
                style="@style/BottomIcon"
                android:contentDescription="@string/bookmarks"
                android:src="@drawable/ic_bookmarks" />

            <ImageView
                android:id="@+id/btnSearch"
                style="@style/BottomIcon"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/btnTabs"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tabs"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnMenu"
                style="@style/BottomIcon"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tam ekran video (YouTube vb.) bu katmana yerleşir -->
    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />
</FrameLayout>
